# The operator/owner of the platform
VITE_OPERATOR=

# Default blockchain network to connect to
VITE_DEFAULT_NETWORK=localhost

# Current environment (development/production)
VITE_ENV=development

# Flag to indicate if running in local environment
VITE_LOCAL=true

# Application name
VITE_APP_NAME=Swop

# Infura API key for connecting to Ethereum networks
VITE_INFURA_ID=

# WalletConnect project ID for wallet integration
VITE_WALLET_CONNECT_PROJECT_ID=""

# Frontend application URL
VITE_APP_URL=http://localhost:3000

# Backend API URL
VITE_API_URL=http://localhost:3001

# Maximum file upload size in bytes (10MB)
VITE_FILE_UPLOAD_MAX_SIZE=10000000

# === Localhost Network Settings ===
# Local backend API URL
VITE_LOCALHOST_API_URL="http://localhost:3001"

# Local blockchain node RPC URL
VITE_LOCALHOST_RPC_URL="http://localhost:8545"

# Smart contract addresses for local development
# Asset Registry contract address - manages registered assets
VITE_LOCALHOST_ASSET_REG_ADDRESS="0xa85233C63b9Ee964Add6F2cffe00Fd84eb32338f"

# Miner Registry contract address - manages miners
VITE_LOCALHOST_MINER_REG_ADDRESS="0x8f86403A4DE0BB5791fa46B8e795C547942fE4Cf"

# Provider Registry contract address - manages service providers
VITE_LOCALHOST_PROVIDER_REG_ADDRESS="0x4c5859f0F772848b2D91F1d83E2Fe57935348029"

# Router contract address - handles routing of transactions
VITE_LOCALHOST_ROUTER_ADDRESS="0xb7278A61aa25c888815aFC32Ad3cC52fF24fE575"

# Badge Manager contract address - handles user badges/achievements
VITE_LOCALHOST_BADGE_MGR_ADDRESS="0x5FbDB2315678afecb367f032d93F642f64180aa3"

# Core contract address - main protocol contract
VITE_LOCALHOST_CORE_ADDRESS="0x68B1D87F95878fE05B998F19b66F4baba5De1aed"

# Dispute Manager contract address - handles dispute resolution
VITE_LOCALHOST_DISPUTE_MGR_ADDRESS="0x851356ae760d987E095750cCeb3bC6014560891C"

# Payment Router contract address - handles payment routing
VITE_LOCALHOST_PAY_ROUTER_ADDRESS="0xCD8a1C3ba11CF5ECfa6267617243239504a98d90"

# Market Manager contract address - handles marketplace operations
VITE_LOCALHOST_MARKET_MGR_ADDRESS="0x82e01223d51Eb87e16A03E24687EDF0F294da6f1"

# NFT contract address - handles NFT operations
VITE_LOCALHOST_NFT_ADDRESS="0x998abeb3E57409262aE5b751f60747921B33613E"

# Energon token contract address - platform utility token
VITE_LOCALHOST_ENERGON_ADDRESS="0x70e0bA845a1A0F2DA3359C97E0285013525FFC49"

# Fee Pool contract address - collects and distributes platform fees
VITE_LOCALHOST_FEE_POOL_ADDRESS="0xc5a5C42992dECbae36851359345FE25997F5C42d"

# Liquidity Pool contract address
VITE_LOCALHOST_LP_POOL_ADDRESS="0x0000000000000000000000000000000000000000"

# Market Core contract address - core marketplace functionality
VITE_LOCALHOST_MARKET_CORE_ADDRESS="0x959922bE3CAee4b8Cd9a407cc3ac1C251C2007B1"

# Mediator Manager contract address - handles dispute mediation
VITE_LOCALHOST_MEDIATOR_MGR_ADDRESS="0x84eA74d481Ee0A5332c457a4d796187F6Ba67fEB"

# Platform Token contract address
VITE_LOCALHOST_TOKEN_ADDRESS="0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0"

# Token Pool contract address
VITE_LOCALHOST_TOKEN_POOL_ADDRESS="0x0000000000000000000000000000000000000000"

# Wrapped Token contract address - wrapped version of native token
VITE_LOCALHOST_WRAPPED_TOKEN_ADDRESS="0x4826533B4897376654Bb4d4AD88B7faFD0C98528"

# Bond Token contract address - used for staking/bonding
VITE_LOCALHOST_BOND_TOKEN_ADDRESS="0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0"

# Native ETH Token contract address
VITE_LOCALHOST_NATIVE_ETH_TOKEN_ADDRESS="0x4826533B4897376654Bb4d4AD88B7faFD0C98528"

# Uniswap Token contract address
VITE_LOCALHOST_UNI_TOKEN_ADDRESS="0x99bbA657f2BbC93c02D617f8bA121cB8Fc104Acf"

# Nigerian Naira Token contract address
VITE_LOCALHOST_NGN_TOKEN_ADDRESS="0x0E801D84Fa97b50751Dbf25036d067dCf18858bF"

# === Sepolia Network Settings ===
# Sepolia testnet API URL
VITE_SEPOLIA_API_URL="https://dev.joint.exchange"

# Sepolia testnet RPC URL
VITE_SEPOLIA_RPC_URL="https://sepolia.infura.io/v3/a31c8f89fcc344149d8b445bc2bc1355"

# === Ethereum Mainnet Settings ===
# Ethereum mainnet API URL
VITE_ETHEREUM_API_URL="http://localhost:3001"

# Ethereum mainnet RPC URL
VITE_ETHEREUM_RPC_URL="http://localhost:8545"

# === Arbitrum Network Settings ===
# Arbitrum network API URL
VITE_ARBITRUM_API_URL="https://dev.joint.exchange"

# Arbitrum network RPC URL
VITE_ARBITRUM_RPC_URL="https://arbitrum.infura.io/v3/f40fe00c286a4ff3b25e426716da895a"